# Deployment environment label.
BULKHEAD_ENV=development
# Local bind host for bulkhead-server.
BULKHEAD_HOST=127.0.0.1
# Local bind port for bulkhead-server.
BULKHEAD_PORT=8000
# Container platforms may provide PORT; Docker's startup command uses it.
# PORT=8000
# Relative or absolute SQLite ledger path; :memory: is ephemeral.
BULKHEAD_DB_PATH=./data/bulkhead.db
# Optional: leave blank to disable API-key authentication.
BULKHEAD_API_KEY=
# Set to 1 to enable the optional deterministic-boundary rationale adapter.
BULKHEAD_LLM_JUDGE=0
# Set to 1 to isolate public visitor sessions and enable the Attack Lab.
BULKHEAD_PUBLIC_DEMO=0
